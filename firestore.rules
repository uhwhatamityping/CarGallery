rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: cars
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, < 100 chars)
    //   - category: string (required, in ['Sports', 'SUV', 'Classic'])
    //   - imageUrl: string (required, base64, < 1000000 chars)
    //   - liked: boolean (required)
    //   - ownerId: string (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    function uidUnchanged() {
      return !('ownerId' in request.resource.data) ||
        request.resource.data.ownerId == request.auth.uid;
    }

    function uidNotModified() {
      return !('ownerId' in request.resource.data) ||
        request.resource.data.ownerId == resource.data.ownerId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidCar(data) {
      return hasOnlyAllowedFields(['name', 'category', 'imageUrl', 'liked', 'ownerId', 'createdAt']) &&
             hasRequiredFields(['name', 'category', 'imageUrl', 'liked', 'ownerId', 'createdAt']) &&
             validStringLength('name', 1, 100) &&
             data.category in ['Sports', 'SUV', 'Classic'] &&
             validStringLength('imageUrl', 1, 1000000) &&
             data.liked is bool &&
             data.ownerId is string &&
             data.createdAt is timestamp;
    }

    match /cars/{carId} {
      allow read: if true; // Public gallery
      allow create: if isAuthenticated() && 
                    isValidCar(request.resource.data) && 
                    request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && 
                    isDocOwner() &&
                    isValidCar(request.resource.data) &&
                    uidNotModified() &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner();
    }
  }
}
